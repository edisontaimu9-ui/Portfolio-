# Copy to .env.local (Vite auto-loads it) and fill in real values.
# Never commit .env.local — it's already covered by the default Vite .gitignore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase console → Project settings → General → your web app → Measurement ID (starts with G-)
VITE_FIREBASE_MEASUREMENT_ID=

# Your deployed Worker URL, e.g. https://portfolio-cms-api.<subdomain>.workers.dev
VITE_CMS_API_URL=
